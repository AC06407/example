<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi Tienda Online</title>
    <style>
        /* Estilos Generales */
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; line-height: 1.6; color: #333; background-color: #f9f9f9; }

        /* Encabezado */
        header { background: #2c3e50; color: white; padding: 2rem 1rem; text-align: center; }
        header h1 { font-size: 2rem; margin-bottom: 0.5rem; }
        header p { font-size: 1.1rem; opacity: 0.9; }

        /* Contenedor Principal */
        .contenedor { max-width: 1000px; margin: 2rem auto; padding: 0 1rem; }

        /* Sección de Producto */
        .producto { display: flex; flex-wrap: wrap; gap: 2rem; background: white; padding: 2rem; border-radius: 10px; box-shadow: 0 4px 10px rgba(0,0,0,0.1); margin-bottom: 2rem; align-items: center; }
        .producto img { width: 100%; max-width: 400px; border-radius: 8px; object-fit: cover; }
        .info { flex: 1; min-width: 250px; }
        .info h2 { font-size: 1.8rem; color: #2c3e50; margin-bottom: 1rem; }
        .precio { font-size: 2rem; color: #27ae60; font-weight: bold; margin: 1rem 0; }
        .descripcion { margin-bottom: 1.5rem; color: #666; }

        /* Botón de Compra */
        .boton-comprar {
            display: inline-block;
            background: #27ae60;
            color: white;
            padding: 15px 35px;
            text-decoration: none;
            border-radius: 5px;
            font-weight: bold;
            font-size: 1.1rem;
            transition: background 0.3s, transform 0.2s;
        }
        .boton-comprar:hover { background: #219a52; transform: translateY(-2px); }

        /* Sección de Opiniones */
        .seccion-opiniones { background: white; padding: 2rem; border-radius: 10px; box-shadow: 0 4px 10px rgba(0,0,0,0.1); }
        .seccion-opiniones h2 { margin-bottom: 1.5rem; color: #2c3e50; border-bottom: 2px solid #eee; padding-bottom: 0.5rem; }
        
        form { display: flex; flex-direction: column; gap: 1rem; }
        input, textarea { padding: 12px; border: 1px solid #ccc; border-radius: 5px; font-size: 1rem; width: 100%; }
        input:focus, textarea:focus { border-color: #2c3e50; outline: none; }
        
        button[type="submit"] {
            background: #2c3e50;
            color: white;
            padding: 12px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 1.1rem;
            font-weight: bold;
            transition: background 0.3s;
        }
        button[type="submit"]:hover { background: #34495e; }

        /* Pie de página */
        footer { text-align: center; padding: 2rem; background: #ecf0f1; margin-top: 3rem; color: #7f8c8d; }
    </style>
</head>
<body>

    <header>
        <h1>Mi Tienda Online</h1>
        <p>Productos de calidad y opiniones reales</p>
    </header>

    <div class="contenedor">

        <!-- SECCIÓN DE PRODUCTO -->
        <section class="producto">
            <!-- Reemplaza 'producto1.jpg' con el nombre real de tu imagen -->
            <img src="producto1.jpg" alt="Producto Destacado">
            <div class="info">
                <h2>Producto Ejemplo Premium</h2>
                <p class="descripcion">Este es un espacio para describir las características principales de tu producto. Destaca sus beneficios y por qué deberían comprarlo.</p>
                <p class="precio">$29.99</p>
                
                <!-- CAMBIA ESTE LINK POR TU PAGO (PayPal, Stripe, MercadoPago) -->
                <a href="https://paypal.me/tuusuario" class="boton-comprar">Comprar Ahora</a>
            </div>
        </section>

        <!-- SECCIÓN DE OPINIONES -->
        <section class="seccion-opiniones">
            <h2>¿Qué opinan nuestros clientes?</h2>
            
            <https://formspree.io/f/xgavqylk>
            <form action="https://formspree.io/f/xgavqylk" method="POST">
                <input type="text" name="nombre" placeholder="Tu nombre" required>
                <input type="email" name="_replyto" placeholder="Tu correo electrónico" required>
                <textarea name="mensaje" rows="5" placeholder="Escribe tu opinión aquí..." required></textarea>
                
                <!-- Campo oculto para que Formspree sepa a dónde redirigir tras enviar -->
                <input type="hidden" name="_next" value="https://tu-usuario.github.io/mi-sitio-web/gracias.html">
                
                <button type="submit">Enviar Opinión</button>
            </form>
        </section>

    </div>

    <footer>
        <p>&copy; 2026 Mi Tienda. Todos los derechos reservados.</p>
    </footer>

</body>
</html>